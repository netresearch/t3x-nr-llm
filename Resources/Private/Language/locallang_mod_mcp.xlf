<xliff
    xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" datatype="plaintext" original="messages">
        <body>
            <trans-unit id="mlang_labels_tablabel">
                <source>MCP Servers</source>
            </trans-unit>
            <trans-unit id="mlang_tabs_tab">
                <source>MCP Servers</source>
            </trans-unit>
            <trans-unit id="mlang_labels_tabdescr">
                <source>Manage external MCP servers and import the tools they advertise</source>
            </trans-unit>
            <trans-unit id="list.title">
                <source>MCP Servers</source>
            </trans-unit>
            <trans-unit id="list.intro">
                <source>Tools imported from an external MCP server run on that server, not here. Importing a catalogue only records what a server offers; each tool stays off until you enable it, and every one requires an administrator. This module is admin-only.</source>
            </trans-unit>
            <trans-unit id="list.empty">
                <source>No MCP server is configured. Add one as a record of type "MCP Server".</source>
            </trans-unit>
            <trans-unit id="server.url">
                <source>Endpoint</source>
            </trans-unit>
            <trans-unit id="server.dataClass">
                <source>Data class</source>
            </trans-unit>
            <trans-unit id="server.enabled">
                <source>Enabled</source>
            </trans-unit>
            <trans-unit id="server.disabled">
                <source>Disabled</source>
            </trans-unit>
            <trans-unit id="server.undeclared">
                <source>No data class declared — this server supplies no tools until you declare one.</source>
            </trans-unit>
            <trans-unit id="server.approval">
                <source>Approval</source>
            </trans-unit>
            <trans-unit id="server.approval.required">
                <source>A human approves every call</source>
            </trans-unit>
            <trans-unit id="server.approval.notRequired">
                <source>Tools run without asking</source>
            </trans-unit>
            <trans-unit id="server.lastImport">
                <source>Last import</source>
            </trans-unit>
            <trans-unit id="server.never">
                <source>Never imported</source>
            </trans-unit>
            <trans-unit id="server.import">
                <source>Import catalogue</source>
            </trans-unit>
            <trans-unit id="server.testConnection">
                <source>Test connection</source>
            </trans-unit>
            <trans-unit id="server.transport">
                <source>Transport</source>
            </trans-unit>
            <trans-unit id="server.authentication">
                <source>Authentication</source>
            </trans-unit>
            <trans-unit id="server.authentication.none">
                <source>None — requests are sent unauthenticated</source>
            </trans-unit>
            <trans-unit id="server.authentication.delegated">
                <source>Delegated — discovery uses a separate credential; tool calls require an actor-bound session</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.connected">
                <source>OAuth — connected to</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.scope">
                <source>Scope</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.expires">
                <source>Access token valid until</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.refreshable">
                <source>renewed automatically</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.reconnect">
                <source>OAuth — the authorization server refused the grant. Connect again.</source>
            </trans-unit>
            <trans-unit id="server.authentication.oauth.notConnected">
                <source>OAuth — not connected. Requests are refused until you connect.</source>
            </trans-unit>
            <trans-unit id="server.oauth.connect">
                <source>Connect</source>
            </trans-unit>
            <trans-unit id="server.oauth.reconnect">
                <source>Connect again</source>
            </trans-unit>
            <trans-unit id="server.oauth.disconnect">
                <source>Disconnect</source>
            </trans-unit>
            <trans-unit id="oauth.result.connected">
                <source>The MCP server is connected. Its tools use the new access token.</source>
            </trans-unit>
            <trans-unit id="oauth.result.disconnected">
                <source>The OAuth connection was removed, and its tokens were deleted from the Vault.</source>
            </trans-unit>
            <trans-unit id="oauth.result.failed">
                <source>The OAuth connection failed (%s).</source>
            </trans-unit>
            <trans-unit id="oauth.result.state_invalid">
                <source>The answer of the authorization server belongs to no connection started in this session. Start the connection again.</source>
            </trans-unit>
            <trans-unit id="oauth.result.state_expired">
                <source>The connection took longer than ten minutes. Start it again.</source>
            </trans-unit>
            <trans-unit id="oauth.result.iss_mismatch">
                <source>The answer came from another authorization server than the one the connection started with. It was discarded.</source>
            </trans-unit>
            <trans-unit id="oauth.result.iss_missing">
                <source>The authorization server announced that it names itself in its answer, and did not. The answer was discarded.</source>
            </trans-unit>
            <trans-unit id="oauth.result.authorization_denied">
                <source>The authorization server did not grant access.</source>
            </trans-unit>
            <trans-unit id="oauth.result.server_not_protected">
                <source>The MCP server answered without asking for a token. Use the authentication mode without credential instead.</source>
            </trans-unit>
            <trans-unit id="oauth.result.pkce_unsupported">
                <source>The authorization server does not offer PKCE with S256, which the MCP specification requires.</source>
            </trans-unit>
            <trans-unit id="oauth.result.registration_unavailable">
                <source>The authorization server offers no dynamic client registration. Enter a pre-registered client ID in the server record.</source>
            </trans-unit>
            <trans-unit id="oauth.result.issuer_changed">
                <source>The MCP server now names another authorization server than the one the pre-registered client belongs to.</source>
            </trans-unit>
            <trans-unit id="oauth.result.host_refused">
                <source>An address of the OAuth flow is not allowed for outbound requests by the Vault host policy.</source>
            </trans-unit>
            <trans-unit id="oauth.result.redirect_uri_insecure">
                <source>The backend is reached over plain HTTP. The authorization server may only send the code back over HTTPS.</source>
            </trans-unit>
            <trans-unit id="oauth.result.unreachable">
                <source>A server of the OAuth flow could not be reached.</source>
            </trans-unit>
            <trans-unit id="oauth.result.vault_capability_missing">
                <source>This client has a secret, and the installed nr-vault cannot send it together with the refresh token. Update nr-vault to 1.2.0 or later, or use a client without a secret.</source>
            </trans-unit>
            <trans-unit id="server.authentication.unsupported">
                <source>Unsupported authentication mode — requests are refused</source>
            </trans-unit>
            <trans-unit id="server.authentication.bearer">
                <source>Bearer token from the vault</source>
            </trans-unit>
            <trans-unit id="server.authentication.header">
                <source>Vault secret in header</source>
            </trans-unit>
            <trans-unit id="server.authentication.other">
                <source>Stored placement, not one this module offers</source>
            </trans-unit>
            <trans-unit id="server.toolsDiscovered">
                <source>Tools discovered</source>
            </trans-unit>
            <trans-unit id="server.lastContact">
                <source>Last successful contact</source>
            </trans-unit>
            <trans-unit id="server.lastContact.never">
                <source>Never reached</source>
            </trans-unit>
            <trans-unit id="server.lastContact.hint">
                <source>Any completed round trip counts: a tool call, an import or a connection test. It is not the same as the last import — a server that has been answering tool calls for weeks can have an old import date.</source>
            </trans-unit>
            <trans-unit id="server.latency">
                <source>Latency</source>
            </trans-unit>
            <trans-unit id="server.lastError">
                <source>Last import error</source>
            </trans-unit>
            <trans-unit id="server.report.reachable">
                <source>Reachable</source>
            </trans-unit>
            <trans-unit id="server.report.protocol">
                <source>Protocol</source>
            </trans-unit>
            <trans-unit id="tools.title">
                <source>Imported tools</source>
            </trans-unit>
            <trans-unit id="tools.none">
                <source>No tools imported yet.</source>
            </trans-unit>
            <trans-unit id="tools.localName">
                <source>Local name</source>
            </trans-unit>
            <trans-unit id="tools.remoteName">
                <source>Name on the server</source>
            </trans-unit>
            <trans-unit id="tools.state">
                <source>State</source>
            </trans-unit>
            <trans-unit id="tools.orphaned">
                <source>Gone from the server</source>
            </trans-unit>
            <trans-unit id="tools.orphanedHint">
                <source>This tool was in an earlier import and the server no longer offers it. The row is kept so the change is visible; the tool is not available to a run.</source>
            </trans-unit>
            <trans-unit id="import.skipped">
                <source>Skipped</source>
            </trans-unit>
        </body>
    </file>
</xliff>
