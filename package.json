{
  "name": "nr_llm-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for nr_llm TYPO3 extension",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <25.0.0",
    "npm": ">=11.5.2"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:a11y": "playwright test --grep @accessibility",
    "axe": "node landingpage/axe-audit.mjs",
    "lint:js": "eslint",
    "lint:colors": "node Build/Scripts/check-backend-colors.mjs && node --test Build/Scripts/check-backend-colors.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "css-tree": "^3.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "espree": "^11.2.0",
    "globals": "^17.0.0",
    "parse5": "^8.0.1"
  }
}
