# Auto-detect text files and normalize line endings
* text=auto eol=lf

# PHP files
*.php text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.neon text eol=lf

# Shell scripts
*.sh text eol=lf

