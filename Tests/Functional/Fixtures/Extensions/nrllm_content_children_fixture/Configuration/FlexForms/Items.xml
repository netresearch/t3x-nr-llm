<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Settings</sheetTitle>
                <type>array</type>
                <el>
                    <columns>
                        <label>Columns</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>2</default>
                            <items type="array">
                                <numIndex index="0" type="array"><label>1</label><value>1</value></numIndex>
                                <numIndex index="1" type="array"><label>2</label><value>2</value></numIndex>
                            </items>
                        </config>
                    </columns>
                    <opened>
                        <label>Opened item</label>
                        <config>
                            <type>input</type>
                        </config>
                    </opened>
                    <settings.intro>
                        <label>Intro</label>
                        <config><type>input</type><max>20</max></config>
                    </settings.intro>
                    <secret>
                        <label>For administrators</label>
                        <exclude>1</exclude>
                        <config><type>input</type></config>
                    </secret>
                    <record>
                        <label>Record</label>
                        <config><type>select</type><renderType>selectSingle</renderType><foreign_table>pages</foreign_table></config>
                    </record>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
