<!DOCTYPE html>
<html lang="{{ lang }}"{% block html_attr %}{% endblock %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ meta.title }}</title>
  <meta name="description" content="{{ meta.description }}">
  {% block robots %}{% endblock %}
  {% if not is_not_found|default(false) %}
  <link rel="canonical" href="{{ canonical }}">
  {% for alt in alternates %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}">
  {% endfor %}
  {% endif %}
  <meta name="theme-color" content="#2F99A4">
  <meta name="color-scheme" content="light dark">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="nr-llm">
  <meta property="og:title" content="{{ meta.title }}">
  <meta property="og:description" content="{{ meta.description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ SITE_URL }}{{ url('assets/img/og-image.png') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="nr-llm — the shared AI foundation for TYPO3">
  <meta property="og:locale" content="{{ 'de_DE' if lang == 'de' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ meta.title }}">
  <meta name="twitter:description" content="{{ meta.description }}">

  <link rel="icon" href="{{ url('assets/img/favicon.svg') }}" type="image/svg+xml">
  <link rel="preload" as="font" type="font/woff2" href="{{ url('assets/fonts/raleway-var.woff2') }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ url('assets/fonts/open-sans-var.woff2') }}" crossorigin>
  <link rel="stylesheet" href="{{ url('assets/css/site.css') }}?v={{ ASSET_VER }}">
  <link rel="stylesheet" href="{{ url('assets/site-shell/site-shell.css') }}?v={{ ASSET_VER }}">

  <script>{{ theme_bootstrap | safe }}</script>
  {% for b in jsonld_blocks %}
  <script type="application/ld+json">{{ b.json | safe }}</script>
  {% endfor %}
</head>
<body{% block body_class %}{% endblock %}>
  <a class="skip-link" href="#main">{{ s.skip }}</a>

  {{ site_header(lang, alternates) | safe }}
  {% if not is_chooser|default(false) %}
  {% set page_tools %}
      {% if not is_chooser|default(false) %}
      <div class="search header-search" data-search hidden>
        <div class="search__field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="18" height="18"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" data-search-input aria-label="{{ s.searchLabel }}" placeholder="{{ s.searchPlaceholder }}">
        </div>
        <ul class="search__results" data-search-results hidden></ul>
        <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
      </div>
      {% endif %}
  {% endset %}
  {{ page_navigation({
    'lang': lang, 'title': 'nr-llm', 'titleHref': url(lang + '/'),
    'links': [
      {'href': nav_prefix + 'solution', 'label': s.nav.solution},
      {'href': nav_prefix + 'dev-kickstart', 'label': s.nav.dev},
      {'href': url(lang + '/features/'), 'label': s.featuresNav},
      {'href': url(lang + '/security/'), 'label': s.nav.security},
      {'href': url('adr/'), 'label': s.nav.adr + (' (Englisch)' if lang == 'de' else '')},
      {'href': 'https://docs.typo3.org/p/netresearch/nr-llm/main/en-us/', 'label': 'Handbuch (Englisch)' if lang == 'de' else 'Manual'}
    ] if show_nav else [], 'toolsHtml': '' if is_landing|default(false) else page_tools
  }) | safe }}
  {% endif %}

  {% macro context_navigation() %}
    <nav class="context-nav container" aria-label="{{ 'Produktübersicht' if lang == 'de' else 'Product overview' }}">
      <a href="https://netresearch.github.io/{{ 'de/' if lang == 'de' else '' }}">{{ 'Open-Source-Portfolio' if lang == 'de' else 'Open-source portfolio' }}</a>
      <span aria-hidden="true">/</span>
      <a href="https://netresearch.github.io/modularer-ki-stack-page/{{ '' if lang == 'de' else 'en/' }}">{{ 'Modularer KI-Stack' if lang == 'de' else 'Modular AI stack' }}</a>
      <span aria-hidden="true">/</span>
      <span>nr-llm</span>
    </nav>
  {% endmacro %}
  <main id="main" tabindex="-1"{% if is_landing|default(false) %} class="nr-hero-page"{% endif %}>
    {% if not is_landing|default(false) %}{{ context_navigation() }}{% endif %}
    {% block main %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <div class="site-footer__brand">
        {#- Brand rule: the logo appears exactly once, in the header. -#}
        <p class="site-footer__tagline">{{ 'KI-Integration und TYPO3-Entwicklung von Netresearch DTT GmbH.' if lang == 'de' else 'AI integration and TYPO3 development by Netresearch DTT GmbH.' }}</p>
      </div>
      <ul class="site-footer__links">
        {% for l in brand.footer.links %}
        <li><a href="{{ {'https://www.netresearch.de/impressum/': 'https://www.netresearch.de/en/imprint/', 'https://www.netresearch.de/datenschutz/': 'https://www.netresearch.de/en/privacy-policy/'}.get(l.href, l.href) if lang == 'en' else l.href }}"{% if 'impressum' in l.href or 'datenschutz' in l.href %} hreflang="{{ lang }}"{% endif %}>{{ {'Impressum': 'Imprint', 'Datenschutz': 'Privacy'}.get(l.label, l.label) if lang == 'en' else l.label }}</a></li>
        {% endfor %}
        <li><a href="{{ url(lang + '/security/') }}">{{ s.nav.security }}</a></li>
        <li><a href="https://github.com/netresearch/t3x-nr-llm">GitHub</a></li>
      </ul>
      <div class="site-footer__meta">
        <span>{{ brand.footer.copyright }} · Netresearch DTT GmbH</span>
        <a href="{{ contact_url('footer', lang) }}" data-cta="business" data-cta-position="footer">{{ 'Kontakt' if lang == 'de' else 'Contact' }}</a>
        <span>{{ 'Seite zuletzt geprüft' if lang == 'de' else 'Page last reviewed' }}: <time datetime="{{ project.last_verified }}">{{ project.last_verified }}</time></span>
        <span>nr-llm · GPL-2.0-or-later</span>
      </div>
    </div>
  </footer>

  <script>window.__NRLLM__ = {{ js_config | tojson }};</script>
  {% if not is_chooser|default(false) %}
  <script defer src="{{ url('assets/js/minisearch.min.js') }}?v={{ ASSET_VER }}"></script>
  <script defer src="{{ url('assets/js/search.js') }}?v={{ ASSET_VER }}"></script>
  <script defer src="{{ url('assets/js/ai-assistant.js') }}?v={{ ASSET_VER }}"></script>
  {% endif %}
  <script defer src="{{ url('assets/js/site.js') }}?v={{ ASSET_VER }}"></script>
  <script defer src="{{ url('assets/site-shell/site-shell.js') }}?v={{ ASSET_VER }}"></script>
</body>
</html>
